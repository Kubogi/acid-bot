# Create a Discord application at https://discord.com/developers/applications
# This is the main bot: it serves /voice commands and is also part of the
# voice-seat rotation pool.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional pool of secondary bot tokens that take turns holding the voice seat.
# Each token belongs to a separate Discord application invited to the same
# server with View Channels and Connect permissions. Comma-separated.
# Leave empty to run single-bot (the main bot stays in voice permanently).
VOICE_BOT_TOKENS=secondary-bot-token-1,secondary-bot-token-2

# Seconds a bot holds the voice seat before the next pool member takes over.
# The replacement joins the channel before the current bot disconnects.
VOICE_ROTATION_SECONDS=10800

# Enable Developer Mode in Discord, right-click your server, and choose Copy Server ID.
GUILD_ID=123456789012345678

# Comma-separated Discord user IDs allowed to run /voice commands.
AUTHORIZED_USER_IDS=111111111111111111,222222222222222222
